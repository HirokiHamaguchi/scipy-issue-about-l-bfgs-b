+static void
+unconstrained_direction(CBLAS_INT n, CBLAS_INT m, double* x, double* g,
+                        double* z, double* ws, double* wy, double* sy,
+                        double theta, CBLAS_INT col, CBLAS_INT head,
+                        double* alpha)
+{
+    CBLAS_INT i, pointr, one_int = 1;
+    double beta, coefficient;
+    double one = 1.0, minus_one = -1.0;
+    double scale = 1.0 / theta;
+
+    // First loop, newest correction first: q = g - sum(alpha_i y_i).
+    BLAS_FUNC(dcopy)(&n, g, &one_int, z, &one_int);
+    for (i = col; i-- > 0; )
+    {
+        pointr = (head + i) % m;
+        alpha[i] = BLAS_FUNC(ddot)(
+            &n, &ws[n*pointr], &one_int, z, &one_int
+        ) / sy[i + m*i];
+        coefficient = -alpha[i];
+        BLAS_FUNC(daxpy)(
+            &n, &coefficient, &wy[n*pointr], &one_int, z, &one_int
+        );
+    }
+
+    // Apply H_0 = I/theta, then loop from oldest correction to newest.
+    BLAS_FUNC(dscal)(&n, &scale, z, &one_int);
+    for (i = 0; i < col; i++)
+    {
+        pointr = (head + i) % m;
+        beta = BLAS_FUNC(ddot)(
+            &n, &wy[n*pointr], &one_int, z, &one_int
+        ) / sy[i + m*i];
+        coefficient = alpha[i] - beta;
+        BLAS_FUNC(daxpy)(
+            &n, &coefficient, &ws[n*pointr], &one_int, z, &one_int
+        );
+    }
+
+    // mainlb expects z to be the trial point, not merely the direction.
+    BLAS_FUNC(dscal)(&n, &minus_one, z, &one_int);
+    BLAS_FUNC(daxpy)(&n, &one, x, &one_int, z, &one_int);
+}
